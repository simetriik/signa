#!/usr/bin/make -f
# Nécessite « uv » et un accès réseau pour embarquer les dépendances Python
# absentes de Debian (voir packaging/requirements-vendor.txt).
LIBDIR = debian/signa/usr/lib/signa

%:
	dh $@

override_dh_auto_test:

override_dh_auto_build:

override_dh_auto_install:
	install -d $(LIBDIR)
	cp -r src/signa $(LIBDIR)/signa
	find $(LIBDIR) -name __pycache__ -prune -exec rm -rf {} +
	uv pip install --target $(LIBDIR)/vendor --python-version 3.13 \
	  --only-binary :all: --no-deps -r packaging/requirements-vendor.txt
	rm -rf $(LIBDIR)/vendor/bin
	install -D -m 755 packaging/signa debian/signa/usr/bin/signa
	install -D -m 644 packaging/signa.desktop debian/signa/usr/share/applications/signa.desktop
	install -D -m 644 src/signa/resources/signa.svg debian/signa/usr/share/icons/hicolor/scalable/apps/signa.svg
	install -D -m 644 packaging/signa.1 debian/signa/usr/share/man/man1/signa.1

# Dépendances déclarées à la main : les bibliothèques embarquées (wheels) sont autonomes.
override_dh_shlibdeps:
override_dh_dwz:
