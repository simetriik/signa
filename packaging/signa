"""Lanceur de Signa : ajoute les bibliothèques du paquet au chemin Python."""

import sys
from pathlib import Path

LIB = Path(__file__).resolve().parent.parent / "lib" / "signa"
sys.path.insert(0, str(LIB / "vendor"))
sys.path.insert(0, str(LIB))

from signa.app import main  # noqa: E402

raise SystemExit(main())
